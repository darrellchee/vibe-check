{
  "name": "vibe-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "collect": "tsx scripts/collect.ts",
    "sync": "tsx scripts/sync.ts",
    "lint": "eslint .",
    "collector:install": "tsx scripts/collector-service.ts install",
    "collector:status": "tsx scripts/collector-service.ts status",
    "collector:uninstall": "tsx scripts/collector-service.ts uninstall"
  },
  "dependencies": {
    "@redis/client": "6.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "fsevents": false
  }
}
