# Local dashboard: reads provider history or Cursor usage exports. Never upload credentials or raw logs.
ATLAS_MODE=local
USAGE_TIMEZONE=Australia/Sydney
# Optional override; omit to use ~/.codex.
# CODEX_HOME=/absolute/path/to/.codex
# Claude Code deletes old transcripts (cleanupPeriodDays, default 30), so the collector
# keeps a private, hashed, token-count-only ledger in data/. Set false to disable it.
# CLAUDE_LEDGER=false
# CLAUDE_LEDGER_PATH=/absolute/path/to/claude-ledger.jsonl
# Claude root containing projects/ (not an individual project directory).
# CLAUDE_HOME=/absolute/path/to/.claude
# Cursor tokens, models and cost, fetched automatically from your own account.
# OPT-IN: reads the login token saved by the Cursor desktop app (never stored,
# logged or uploaded) and calls Cursor's undocumented dashboard usage endpoint,
# read-only, at most every 10 minutes. Leave unset to read no credentials.
# CURSOR_AUTO_SYNC=true
# Or import manually: choose one CSV file or an export directory.
# CURSOR_USAGE_CSV=/absolute/path/to/usage-events.csv
# CURSOR_USAGE_DIR=/absolute/path/to/cursor-exports
# Default export directory: data/cursor-imports (ignored by Git).
# Cursor database used for activity (and the auto-sync login). Defaults to the app's own.
# CURSOR_DB_PATH=/absolute/path/to/Cursor/User/globalStorage/state.vscdb
# Antigravity parent folder containing antigravity/ and antigravity-cli/ (default ~/.gemini).
# ANTIGRAVITY_HOME=/absolute/path/to/.gemini


# Optional on Vercel: a deployed copy generates its password when you claim it at /setup.
# Required for production local mode, and for any deployment you manage with env vars.
# Choose a long, unique password. Do not reuse your Codex account password.
DASHBOARD_PASSWORD=

# Cloud deployment only. Vercel's Upstash integration sets these (as KV_REST_API_*) for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional on Vercel: the install command writes a per-computer token to .env.local for you.
# To manage it yourself, use the same random secret (32+ characters) on collector and cloud.
SYNC_TOKEN=
# Collector only: deployed dashboard origin, without /api/ingest.
SYNC_URL=

# Anonymous GitHub README cards. Leave unset to follow the claimed site's default (public).
# Set a provider to false to keep it private, or true to publish it without claiming.
# Local development and self-managed servers default to private.
# PUBLIC_WIDGET=false
# PUBLIC_CLAUDE_WIDGET=false
# PUBLIC_CURSOR_WIDGET=false
# PUBLIC_ANTIGRAVITY_WIDGET=false
